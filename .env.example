# LinkedIn (get li_at cookie from browser DevTools > Application > Cookies)
# LINKEDIN_COOKIE=your_li_at_cookie_value

# GitHub personal access token (optional, raises the API cap from 60/hr to 5000/hr)
# GITHUB_TOKEN=your_github_token

# Hunter.io API key (optional, free tier = 25 lookups/month)
# HUNTER_API_KEY=your_hunter_api_key

# Proxy support (optional, pick one)
# VERTEX_PROXY=http://user:pass@host:port
# VERTEX_PROXY_FILE=proxies.txt
# VERTEX_FREE_PROXY=true

# Delay between scrapes, in seconds
# VERTEX_DELAY_MIN=1.0
# VERTEX_DELAY_MAX=2.5
